APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Leave: set to false to stop every leave email (submitted / recommended / approved / denied / HR notice).
# In-app (bell) notifications are unaffected. The HR-notice switch defaults to the first one; set it to
# false to stop only the HR emails.
GWL_LEAVE_EMAIL_NOTIFICATIONS_ENABLED=true
# GWL_LEAVE_HR_EMAIL_NOTIFICATIONS_ENABLED=true

# Letters: most letters one transmittal (batch dispatch) may hold (one printed sheet).
# GWL_LETTERS_MAX_BATCH_SIZE=50
# Letters: days before an unconfirmed hand-over is overdue (amber; red at twice that), and hours between reminders.
# GWL_LETTERS_UNCONFIRMED_ALERT_DAYS=2
# GWL_LETTERS_REMIND_COOLDOWN_HOURS=24
# Letters: most rows one holder's register (preview, Excel, PDF) may have before the range must be narrowed.
# GWL_LETTERS_REGISTER_MAX_ROWS=5000
# Letters: optional scans of the hardcopy. Off by default. Stored on a private disk (back up storage/app/private/letters).
# GWL_LETTERS_SCANS_ENABLED=false
# GWL_LETTERS_SCAN_DISK=local
# GWL_LETTERS_SCAN_MAX_KB=10240
# GWL_LETTERS_SCAN_MAX_FILES=10
# GWL_LETTERS_SCAN_PREVIEW_BEFORE_CONFIRM=false

# Credit Union module: paused pending a standalone Credit Union app — see credit-union-module-design.md §10
GWL_CREDIT_UNION_MODULE_ENABLED=false

# --- Android Enterprise / MDM (Assets module) — full setup in docs/assets/mdm.md ---
# Master switch. When false the MDM routes (including /webhooks/android-management) don't register
# and the MDM sidebar entries are hidden.
GWL_MDM_ENABLED=false
# Google Cloud project that owns the Android Management API + Pub/Sub topic.
GOOGLE_CLOUD_PROJECT_ID=
# ABSOLUTE path to the service-account JSON key. Keep it OUTSIDE the web root and outside git
# (e.g. C:\secrets\gwl-amapi.json). Never commit it or paste its contents anywhere.
GOOGLE_APPLICATION_CREDENTIALS=
# Filled in once, after `php artisan mdm:enterprise-create`, e.g. enterprises/LC0xxxxxxx
ANDROID_MANAGEMENT_ENTERPRISE_ID=
# Minutes an enrollment QR stays valid (one-time use).
GWL_MDM_ENROLLMENT_TOKEN_MINUTES=60
# Defaults shown on a phone in Lost Mode (can be overridden per phone in the UI).
GWL_MDM_LOST_MODE_MESSAGE="This phone is company property and has been reported lost. Please contact the number shown to return it."
GWL_MDM_LOST_MODE_PHONE=
GWL_MDM_LOST_MODE_ADDRESS=
# Pub/Sub topic + subscription that receive Google's device notifications.
GWL_MDM_PUBSUB_TOPIC=
GWL_MDM_PUBSUB_SUBSCRIPTION=
# How events reach the ERP: "pull" (scheduled mdm:poll-events; use this on Laragon / while the ERP is not
# publicly reachable) or "push" (Google POSTs to /webhooks/android-management over public HTTPS).
GWL_MDM_PUBSUB_MODE=pull
# Push mode only. The subscription's OIDC audience, the dedicated push service account's email, and a
# long random secret appended to the endpoint as ?token= (second factor). Never log or share the token.
GWL_MDM_PUBSUB_PUSH_AUDIENCE=
GWL_MDM_PUBSUB_PUSH_SERVICE_ACCOUNT=
GWL_MDM_PUBSUB_PUSH_TOKEN=
