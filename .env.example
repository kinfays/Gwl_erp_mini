APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Leave: set to false to stop every leave email (submitted / recommended / approved / denied / HR notice).
# In-app (bell) notifications are unaffected. The HR-notice switch defaults to the first one; set it to
# false to stop only the HR emails.
GWL_LEAVE_EMAIL_NOTIFICATIONS_ENABLED=true
# GWL_LEAVE_HR_EMAIL_NOTIFICATIONS_ENABLED=true

# Leave: annual entitlement by grade (defaults shown; staff with no grade keep GWL_LEAVE_DAYS_UNGRADED).
# GWL_LEAVE_DAYS_JUNIOR_LOWER_SHORT=26
# GWL_LEAVE_DAYS_JUNIOR_LOWER_LONG=31
# GWL_LEAVE_DAYS_JUNIOR_UPPER=31
# GWL_LEAVE_DAYS_SENIOR_MANAGEMENT=36
# GWL_LEAVE_DAYS_UNGRADED=31
# GWL_LEAVE_JUNIOR_LOWER_TENURE_YEARS=10
# Compulsory leave days for a year that has no record on the Compulsory Leave page.
# GWL_LEAVE_COMPULSORY_DEFAULT_DAYS=11

# HR analytics: the retirement age, how many months ahead "approaching retirement" looks, and how long the result is reused (0 = no cache).
# GWL_RETIREMENT_AGE=60
# GWL_RETIREMENT_WINDOW_MONTHS=12
# GWL_HR_ANALYTICS_CACHE_SECONDS=120

# Letters: most letters one transmittal (batch dispatch) may hold (one printed sheet).
# GWL_LETTERS_MAX_BATCH_SIZE=50
# Letters: days before an unconfirmed hand-over is overdue (amber; red at twice that), and hours between reminders.
# GWL_LETTERS_UNCONFIRMED_ALERT_DAYS=2
# GWL_LETTERS_REMIND_COOLDOWN_HOURS=24
# Letters: most rows one holder's register (preview, Excel, PDF) may have before the range must be narrowed.
# GWL_LETTERS_REGISTER_MAX_ROWS=5000
# Letters: optional scans of the hardcopy. Off by default. Stored on a private disk (back up storage/app/private/letters).
# GWL_LETTERS_SCANS_ENABLED=false
# GWL_LETTERS_SCAN_DISK=local
# GWL_LETTERS_SCAN_MAX_KB=10240
# GWL_LETTERS_SCAN_MAX_FILES=10
# GWL_LETTERS_SCAN_PREVIEW_BEFORE_CONFIRM=false

# Credit Union module: paused pending a standalone Credit Union app — see credit-union-module-design.md §10
GWL_CREDIT_UNION_MODULE_ENABLED=false

illing & meter-reading analytics from Excel uploads) - see docs/commercial-module-design.md ---
# Master switch. When false the Commercial routes don't register and the module is hidden from navigation.
GWL_COMMERCIAL_MODULE_ENABLED=false
# Biggest report upload accepted (MB). Keep at or below PHP upload_max_filesize / post_max_size.
GWL_COMMERCIAL_IMPORT_MAX_MB=10
# Reader analytics thresholds (used from Phase 2).
GWL_COMMERCIAL_MIN_VISITS_FOR_OUTLIER=200
GWL_COMMERCIAL_OUTLIER_ZSCORE=2.0
# Readers a district needs before its reading figures are shown to users who may not see individual readers.
GWL_COMMERCIAL_MIN_READERS_FOR_DISTRICT_FIGURES=3
GWL_COMMERCIAL_WORKLOAD_LOW_PCT=50
GWL_COMMERCIAL_WORKLOAD_HIGH_PCT=150
# PLACEHOLDER targets # --- Health & Safety module (incident reporting; equipment and PPE follow) - see docs/claude_health-safety-module-design.md ---
# Master switch. When false the Health & Safety routes don't register and the module is hidden from navigation.
GWL_HEALTH_SAFETY_MODULE_ENABLED=false
# PLACEHOLDERS until the EHS department confirms them.
GWL_HS_ACK_HOURS=24
GWL_HS_INVESTIGATION_DUE_DAYS=14
GWL_HS_ATTACHMENT_MAX_MB=5
GWL_HS_ATTACHMENTS_PER_INCIDENT=5
# Emergency numbers shown at the top of the report form, "Label: number" separated by | (hidden while empty).
GWL_HS_EMERGENCY_CONTACTS=

# --- Commercial module (buntil the Commercial team confirms the real ones.
GWL_COMMERCIAL_TARGET_SKIP_RATE_PCT=10
GWL_COMMERCIAL_TARGET_COVERAGE_PCT=90
GWL_COMMERCIAL_TARGET_COLLECTION_PCT=95
# Most rows one Commercial export may hold (Excel / PDF); over it the user is asked to narrow the filters.
GWL_COMMERCIAL_EXPORT_MAX_ROWS=5000
# PDFs are heavier to build than spreadsheets, so they have their own lower cap.
GWL_COMMERCIAL_EXPORT_PDF_MAX_ROWS=1500
# Upload reminders (placeholders until the real cadence is confirmed): days without an upload before officers are told.
GWL_COMMERCIAL_REMINDERS_ENABLED=true
GWL_COMMERCIAL_REMINDER_READING_DAYS=10
GWL_COMMERCIAL_REMINDER_BILLING_DAYS=35
GWL_COMMERCIAL_REMINDER_REPEAT_DAYS=7
# Billing route exceptions (placeholders to confirm).
GWL_COMMERCIAL_EXCEPTION_MIN_CUSTOMERS=3
GWL_COMMERCIAL_EXCEPTION_HIGH_UNBILLED_PCT=25
GWL_COMMERCIAL_EXCEPTION_HIGH_ESTIMATION_PCT=75
GWL_COMMERCIAL_EXCEPTION_CREDIT_AMOUNT=300
# Reader scorecard weights (indicative; a first guess).
GWL_COMMERCIAL_SCORE_WEIGHT_VOLUME=0.4
GWL_COMMERCIAL_SCORE_WEIGHT_SKIP=0.4
GWL_COMMERCIAL_SCORE_WEIGHT_CONSISTENCY=0.2

# --- Android Enterprise / MDM (Assets module) — full setup in docs/assets/mdm.md ---
# Master switch. When false the MDM routes (including /webhooks/android-management) don't register
# and the MDM sidebar entries are hidden.
GWL_MDM_ENABLED=false
# Google Cloud project that owns the Android Management API + Pub/Sub topic.
GOOGLE_CLOUD_PROJECT_ID=
# ABSOLUTE path to the service-account JSON key. Keep it OUTSIDE the web root and outside git
# (e.g. C:\secrets\gwl-amapi.json). Never commit it or paste its contents anywhere.
GOOGLE_APPLICATION_CREDENTIALS=
# Filled in once, after `php artisan mdm:enterprise-create`, e.g. enterprises/LC0xxxxxxx
ANDROID_MANAGEMENT_ENTERPRISE_ID=
# Minutes an enrollment QR stays valid (one-time use).
GWL_MDM_ENROLLMENT_TOKEN_MINUTES=60
# Defaults shown on a phone in Lost Mode (can be overridden per phone in the UI).
GWL_MDM_LOST_MODE_MESSAGE="This phone is company property and has been reported lost. Please contact the number shown to return it."
GWL_MDM_LOST_MODE_PHONE=
GWL_MDM_LOST_MODE_ADDRESS=
# Pub/Sub topic + subscription that receive Google's device notifications.
GWL_MDM_PUBSUB_TOPIC=
GWL_MDM_PUBSUB_SUBSCRIPTION=
# How events reach the ERP: "pull" (scheduled mdm:poll-events; use this on Laragon / while the ERP is not
# publicly reachable) or "push" (Google POSTs to /webhooks/android-management over public HTTPS).
GWL_MDM_PUBSUB_MODE=pull
# Push mode only. The subscription's OIDC audience, the dedicated push service account's email, and a
# long random secret appended to the endpoint as ?token= (second factor). Never log or share the token.
GWL_MDM_PUBSUB_PUSH_AUDIENCE=
GWL_MDM_PUBSUB_PUSH_SERVICE_ACCOUNT=
GWL_MDM_PUBSUB_PUSH_TOKEN=

# --- Regional Blog (PR articles about regional activities, meetings, workshops and training) - see docs/14-module-regional-blog.md ---
# Master switch (default on). When false the Blog routes don't register and the module is hidden from navigation.
GWL_BLOG_MODULE_ENABLED=true
# Biggest cover photo accepted (MB). Keep at or below PHP upload_max_filesize / post_max_size.
GWL_BLOG_COVER_MAX_MB=3
